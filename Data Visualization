import pandas as pd
import numpy as np
import pickle
import re
import os

# 영화 제목과 리뷰 입력
movie_title = input("영화 제목을 입력하세요: ").strip()
user_review = input("리뷰를 입력하세요: ").strip()

# 전처리 함수
def clean_text(text):
    text = str(text).lower()
    text = re.sub(r"[^가-힣a-zA-Z0-9\s]", "", text)
    text = re.sub(r"\s+", " ", text).strip()
    return text

# 리뷰 전처리
cleaned = clean_text(user_review)

# 모델과 벡터라이저 로드
with open("sentiment_model.pkl", "rb") as f:
    model = pickle.load(f)

with open("vectorizer.pkl", "rb") as f:
    vectorizer = pickle.load(f)

# 벡터화 및 예측
X_new = vectorizer.transform([cleaned])
pred = model.predict(X_new)[0]  # 0: 부정, 1: 긍정
label_text = "긍정 😊" if pred == 1 else "부정 😠"

# 예측 결과 출력
print("예측된 감정 라벨:", label_text)

# 기존 엑셀 파일 불러오기
file_path = "새로운 리뷰 데이터베이스.xlsx"
if os.path.exists(file_path):
    df = pd.read_excel(file_path)
else:
    df = pd.DataFrame(columns=["영화제목", "리뷰", "label"])

# 새 데이터 추가
new_data = pd.DataFrame([[movie_title, user_review, label_text]], columns=["영화제목", "리뷰", "label"])
df = pd.concat([df, new_data], ignore_index=True)

# 저장
df.to_excel(file_path, index=False)
print(f"리뷰와 예측 결과가 '{file_path}' 파일에 저장되었습니다.")
