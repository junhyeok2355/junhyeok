import re

# 간단한 전처리 함수 정의
def clean_text(text):
    text = str(text).lower()                      # 소문자화
    text = re.sub(r"[^가-힣a-zA-Z0-9\s]", "", text)  # 특수문자 제거
    text = re.sub(r"\s+", " ", text).strip()      # 불필요한 공백 제거
    return text

# review 컬럼에 전처리 적용
df['clean_review'] = df['리뷰'].apply(clean_text)

