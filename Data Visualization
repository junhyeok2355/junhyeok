]

# 토큰화 함수
def tokenize(text):
    tokens = okt.morphs(text, stem=True)  # 어간 추출 포함
    tokens = [word for word in tokens if word not in stopwords]  # 불용어 제거
    return tokens

# TF-IDF 벡터화 (tokenizer는 우리가 만든 함수 사용)
